# -----------------------------------------------------------------------------
# Veil proxy configuration. Copy to .env and adjust. Every value is optional;
# the defaults are safe for a single-instance deployment.
# -----------------------------------------------------------------------------

# --- Server -------------------------------------------------------------------
HOST=0.0.0.0
# Port the app listens on (dedicated default: 43117).
PORT=43117
# docker compose only: port published on the host, and the host interface to
# bind (127.0.0.1 = only reachable through a local reverse proxy).
HOST_PORT=43117
BIND_ADDR=127.0.0.1
# Public host names this proxy is reachable under (comma separated). These are
# always blocked as destinations so the proxy can't be pointed at itself.
# On Coolify, the domain from COOLIFY_FQDN is added automatically.
PUBLIC_HOSTNAMES=

# --- Reverse proxy / client IP ----------------------------------------------
# Leave both unset when clients connect directly. Only set them when a trusted
# reverse proxy sits in front, otherwise clients can spoof their IP.
# Number of trusted proxies appending to X-Forwarded-For (Nginx in front = 1).
TRUST_PROXY_HOPS=0
# Or a single header set by your edge, e.g. cf-connecting-ip (Cloudflare) or x-real-ip.
CLIENT_IP_HEADER=

# --- Destination policy -------------------------------------------------------
# Private, loopback, link-local, CGNAT, multicast, reserved and metadata
# addresses are ALWAYS blocked; these lists add to that.
# If set, ONLY these hosts may be proxied. Supports *.example.com wildcards.
ALLOWED_HOSTS=
# Hosts that may never be proxied. Supports *.example.com wildcards.
BLOCKED_HOSTS=
# Extra IP ranges to block, e.g. your own public ranges: 203.0.113.0/24,2001:db8::/32
BLOCKED_CIDRS=
# Destination ports allowed. Default 80,443. Use * to allow any port (not recommended).
ALLOWED_PORTS=80,443

# --- Limits -------------------------------------------------------------------
CONNECT_TIMEOUT_MS=10000
RESPONSE_TIMEOUT_MS=25000
IDLE_TIMEOUT_MS=30000
# Max bytes streamed for a single response (downloads, media).
MAX_RESPONSE_BYTES=104857600
# Max decompressed size of an HTML/CSS document that gets rewritten.
MAX_REWRITE_BYTES=8388608
MAX_REQUEST_BODY_BYTES=10485760
MAX_CONCURRENT_REQUESTS=128
MAX_CONCURRENT_PER_IP=24
MAX_QUEUE=512
QUEUE_TIMEOUT_MS=15000
# Token bucket per client IP (a single page load can make dozens of requests).
RATE_LIMIT_PER_MINUTE=600
RATE_LIMIT_BURST=200

# --- Sessions & cookies -------------------------------------------------------
# Upstream cookies are kept server-side, per browser session. Disable to make
# the proxy fully stateless (logins won't persist).
ENABLE_COOKIES=true
# auto = Secure flag when the request arrived over HTTPS (needs TRUST_PROXY_HOPS
# or CLIENT_IP_HEADER behind a TLS-terminating proxy). true | false | auto
COOKIE_SECURE=auto
SESSION_TTL_MINUTES=120
MAX_SESSIONS=2000
MAX_COOKIE_BYTES_PER_SESSION=262144
SESSIONS_PER_IP_PER_HOUR=60

# --- WebSockets ---------------------------------------------------------------
ENABLE_WEBSOCKETS=true
MAX_WEBSOCKETS=500
MAX_WEBSOCKETS_PER_IP=16
WS_IDLE_TIMEOUT_MS=120000
WS_MAX_BYTES=268435456

# --- Behaviour ----------------------------------------------------------------
# compat : best site compatibility; proxied pages share the proxy origin.
# sandbox: pages run in an opaque-origin CSP sandbox; stronger isolation
#          between proxied sites, but storage/logins break on many sites.
ISOLATION_MODE=compat
# Search engine used for non-URL input. Must contain %s.
SEARCH_URL=https://duckduckgo.com/html/?q=%s
# Override the User-Agent sent upstream (empty = forward the browser's).
UPSTREAM_USER_AGENT=
# Log one line per request (client IP, method, status, destination host only).
LOG_REQUESTS=false

# --- AI assistant ---------------------------------------------------------------
# Add a free API key for each provider you want. They are tried in order
# (fastest first); when one hits its free limit or fails, the next one answers
# and the tired one rests until its limit resets. Leave all empty to hide the AI.
#
#   Groq        https://console.groq.com/keys         fast, generous daily requests
#   Cerebras    https://cloud.cerebras.ai             fast, large token budget
#   Gemini      https://aistudio.google.com/apikey    Google's free tier
#   Mistral     https://console.mistral.ai            free "Experiment" plan
#   OpenRouter  https://openrouter.ai/keys            many ":free" models, low daily cap
GROQ_API_KEY=
CEREBRAS_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
# Optional model overrides (free catalogs change; defaults shown)
# GROQ_MODEL=llama-3.3-70b-versatile
# CEREBRAS_MODEL=gpt-oss-120b
# GEMINI_MODEL=gemini-2.5-flash
# MISTRAL_MODEL=mistral-small-latest
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Self-hosted Ollama as an unlimited last resort (no key). With docker compose
# --profile ai this is http://ollama:11434
OLLAMA_BASE_URL=
# OLLAMA_MODEL=llama3.2:3b

# Any other OpenAI-compatible API (up to AI_9_*), e.g. PhotonAI once it launches:
# AI_1_NAME=PhotonAI
# AI_1_BASE_URL=https://.../v1
# AI_1_API_KEY=
# AI_1_MODEL=

# Order to try providers in (default below). "custom" = the AI_n_* providers.
# AI_ORDER=groq,cerebras,gemini,mistral,openrouter,custom,ollama
# priority = always start with the first available; round-robin = spread load
AI_STRATEGY=priority
# Check keys/models at startup via GET /models (uses no free quota)
AI_STARTUP_CHECK=true
# Move on to the next provider if one hasn't started answering within this time
AI_ATTEMPT_TIMEOUT_MS=20000

AI_NAME=Veil AI
# AI_SYSTEM_PROMPT=
# --- Keeping API usage low ---
# Max length of each answer (tokens). Lower = cheaper; 1024 is ~700 words.
AI_MAX_TOKENS=1024
AI_TEMPERATURE=0.7
AI_TIMEOUT_MS=120000
# Reuse answers to identical first questions (incl. suggestion buttons) instead
# of calling the API again. 0 disables.
AI_CACHE_TTL_MINUTES=1440
AI_CACHE_MAX_ENTRIES=500
# Only the most recent part of a conversation is sent with each message.
AI_MAX_HISTORY_MESSAGES=12
AI_MAX_HISTORY_CHARS=8000
# Per-visitor limits
AI_REQUESTS_PER_HOUR=30
AI_MAX_INPUT_CHARS=4000
# Answers generated at the same time across all visitors
AI_MAX_CONCURRENT=4
